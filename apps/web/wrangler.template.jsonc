// The source of wrangler.jsonc, which tooling/wire renders from it: from
// wiring.fixture.json for local work (`pnpm run wire:fixture`, committed as
// that render), and on every Orun lane from the wiring document the
// `cloudflare-r2` Terraform root lease-publishes (WIRING_CLOUDFLARE_R2_<ENV>)
// — dev, which no root applies to, from the fixture (component.yaml's
// buildCommand). Edit this file, never wrangler.jsonc. The workers-assets
// composition deploys one environment per job with no wrangler `--env`, so
// `__ENV__` names the environment this config is rendered for. The Worker's
// name carries it (cms-drupal-web-stage, cms-drupal-web-prod — the composition's
// `workerName` + environment) because the self-reference service binding
// below must name exactly the Worker it runs in.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cms-drupal-web-__ENV__",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // No `vars`: the site's name is site.ts and the Drupal it reads is decided
  // at build (next.config.ts `env`, from the environment's Orun secrets).
  // DRUPAL_CLIENT_ID / DRUPAL_CLIENT_SECRET (the OAuth client preview reads
  // drafts with) and DRUPAL_REVALIDATE_SECRET (the `?secret=` /api/revalidate
  // checks) are Worker secrets the deploy hands over
  // (tooling/wire/worker-secrets.mjs); without the first two preview cannot
  // read a draft, without the last the route refuses every call.

  // The Next.js incremental cache — every rendered page — in the bucket
  // infra/terraform/cloudflare-r2 provisions.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "@@wiring(cloudflare-r2/__ENV__:r2_bucket_name)@@",
    },
  ],
  // `res.revalidate` (and the queue's re-renders) request the page from the
  // Worker itself, which a Worker can only do through a service binding to
  // its own name.
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "cms-drupal-web-__ENV__" },
  ],
}
