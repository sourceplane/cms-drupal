# Local settings for `pnpm dev` (copy to .env.local) — a deployed site reads
# these from the environment's Orun secrets instead (component.yaml).
#
# The Drupal site (with the next, decoupled_router, jsonapi_menu_items,
# jsonapi_views and simple_oauth modules — README → Connecting Drupal).
# Left empty, the site renders the bundled sample content.
DRUPAL_BASE_URL=""
# The template's multi-site filter (field_site); empty for a Drupal without it.
DRUPAL_SITE_ID=""
DRUPAL_FRONT_PAGE="/home"
# The OAuth client preview reads drafts with (Drupal's Consumer).
DRUPAL_CLIENT_ID=""
DRUPAL_CLIENT_SECRET=""
# The `?secret=` /api/revalidate requires; empty turns revalidation off.
DRUPAL_REVALIDATE_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
